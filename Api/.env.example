# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# Database (MariaDB / MySQL)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=mirage
DATABASE_PASSWORD=changeme
DATABASE_NAME=mirage
DATABASE_CONNECTION_LIMIT=10

# Auth: shared secret used by the s&box host to authenticate against this API.
# Generate with: openssl rand -hex 32
API_BEARER_TOKEN=replace_with_a_long_random_secret_at_least_32_chars
