@*
    @author Epyi
*@
@using Sandbox
@using Sandbox.UI
@inherits Panel
@namespace Sandbox.Mirage.UI

<root class="mirage-checkbox @(Checked ? "mirage-checkbox--checked" : "") @(Disabled ? "mirage-checkbox--disabled" : "")"
      @onclick="@OnRootClick">

    <div class="box">
        <div class="mark">@(Checked ? "✓" : "")</div>
    </div>

    @if ( !string.IsNullOrEmpty( LabelText ) )
    {
        <Label class="text" Text="@LabelText" />
    }

</root>

@code
{
    [Parameter] public string LabelText { get; set; }
    [Parameter] public bool Checked { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Action<bool> OnChange { get; set; }

    private void OnRootClick()
    {
        if ( Disabled ) return;
        Checked = !Checked;
        OnChange?.Invoke( Checked );
        StateHasChanged();
    }
}
