@*
    @author Epyi
*@
@using Sandbox
@using Sandbox.UI
@inherits Panel
@namespace Sandbox.Mirage.UI

<root class="mirage-button mirage-button--@(Variant.ToString().ToLower()) mirage-button--@(Size.ToString().ToLower()) @(FullWidth ? "mirage-button--full" : "") @(Disabled ? "mirage-button--disabled" : "")"
      @onclick="@OnRootClick">

    @if ( !string.IsNullOrEmpty( Icon ) )
    {
        <i class="icon">@Icon</i>
    }
    @if ( !string.IsNullOrEmpty( Text ) )
    {
        <Label class="text" Text="@Text" />
    }

</root>

@code
{
    public enum ButtonVariant { Primary, Secondary, Ghost, Danger }
    public enum ButtonSize { Small, Medium, Large }

    [Parameter] public string Text { get; set; }
    [Parameter] public string Icon { get; set; }
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Secondary;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Medium;
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Action ClickAction { get; set; }

    private void OnRootClick()
    {
        if ( Disabled ) return;
        ClickAction?.Invoke();
    }
}
