@*
    @author Epyi
*@
@using Sandbox
@using Sandbox.UI
@using Sandbox.Mirage
@inherits PanelComponent
@namespace Sandbox.Mirage.UI

@if ( !_player.IsValid() || _player.WantsHideHud )
    return;

<root class="mirage-health-hud">

    @{
        var hp = (int)Math.Ceiling( _player.Health );
        var max = _player.MaxHealth <= 0 ? 100 : (int)_player.MaxHealth;
        var hpFrac = max <= 0 ? 0f : Math.Clamp( _player.Health / max, 0f, 1f );
        var hpPercent = (int)( hpFrac * 100f );
        var armour = (int)Math.Ceiling( _player.Armour );
        var armourFrac = Math.Clamp( _player.Armour / 100f, 0f, 1f );
        var armourPercent = (int)( armourFrac * 100f );
    }

    <div class="row">
        <Label class="row-key" Text="HP" />
        <div class="row-bar">
            <div class="row-fill" style="width: @(hpPercent)%;"></div>
        </div>
        <Label class="row-value" Text="@hp.ToString()" />
    </div>

    @if ( armour > 0 )
    {
        <div class="row row--armour">
            <Label class="row-key" Text="ARM" />
            <div class="row-bar bar--armour">
                <div class="row-fill" style="width: @(armourPercent)%;"></div>
            </div>
            <Label class="row-value" Text="@armour.ToString()" />
        </div>
    }

</root>

@code
{
    private Player _player;
    private float _renderedHp = -1f;
    private float _renderedArmour = -1f;
    private bool _renderedHidden;

    protected override void OnUpdate()
    {
        _player = Player.FindLocalPlayer();
        if ( !_player.IsValid() ) return;

        // Health and Armour are floats synced from the host. We re-render
        // any time the visible value would change (rounded ceiling), so a
        // single point of damage is reflected immediately. BuildHash is
        // not enough on its own here: the engine only diffs identical
        // hashes, but we want the bar width transition to start from the
        // exact moment the player took damage.
        var hidden = _player.WantsHideHud;
        if ( Math.Abs( _player.Health - _renderedHp ) > 0.05f
            || Math.Abs( _player.Armour - _renderedArmour ) > 0.05f
            || hidden != _renderedHidden )
        {
            _renderedHp = _player.Health;
            _renderedArmour = _player.Armour;
            _renderedHidden = hidden;
            StateHasChanged();
        }
    }

    protected override int BuildHash()
    {
        if ( !_player.IsValid() ) return 0;
        return System.HashCode.Combine( _player.WantsHideHud, _player.Health, _player.MaxHealth, _player.Armour );
    }
}
