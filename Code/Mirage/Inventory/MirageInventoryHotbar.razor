@*
    @author Epyi
*@
@using Sandbox
@using Sandbox.UI
@using Sandbox.Mirage
@using Sandbox.Mirage.UI
@inherits PanelComponent
@namespace Sandbox.Mirage.UI

<root class="mirage-hotbar @(_isHidden ? "mirage-hotbar--hidden" : "")">

    <div class="hotbar-announce @(_announceVisible ? "is-visible" : "")">
        <Label Text="@_announceText" />
    </div>

    @for ( int i = 0; i < MirageInventory.HotbarColumns; i++ )
    {
        var idx = i;
        var slot = _inventory?.Slot( idx );
        var item = slot?.Item;
        var selected = _inventory?.SelectedSlot == idx;
        var empty = slot is null || slot.IsEmpty;
        <div class="cell @(selected ? "cell--selected" : "") @(empty ? "cell--empty" : "")"
             @onclick="@(() => OnCellClick( idx ))">
            <div class="cell-top">
                <Label class="cell-key" Text="@((idx + 1).ToString())" />
            </div>
            <div class="cell-letter">
                @if ( !empty )
                {
                    if ( !string.IsNullOrEmpty( item?.Image ) )
                    {
                        <div class="cell-icon-stack">
                            <div class="cell-icon cell-icon--glow" style="background-image: url(@item.Image);"></div>
                            <div class="cell-icon" style="background-image: url(@item.Image);"></div>
                        </div>
                    }
                    else
                    {
                        <Label Text="@GetItemBadge( item, slot.ItemId )" />
                    }
                }
            </div>
            @if ( !empty && slot.Count > 1 )
            {
                <Label class="cell-count" Text="@($"x{slot.Count}")" />
            }
        </div>
    }

</root>

@code
{
    private MirageInventory _inventory;
    private int _renderedVersion = -1;
    private bool _isHidden;

    // Minecraft-style item-name announcement that shows above the hotbar
    // for a short window after a slot switch and fades out.
    private const float AnnounceHoldSeconds = 1.6f;
    private string _announceText = "";
    private bool _announceVisible;
    private RealTimeUntil _announceUntil;
    private int _lastAnnouncedSlot = -2;

    protected override void OnUpdate()
    {
        _inventory ??= MirageInventory.ForLocalPlayer();
        if ( _inventory is null )
        {
            if ( !_isHidden ) { _isHidden = true; StateHasChanged(); }
            return;
        }

        var pd = _inventory.GameObject?.GetComponentInParent<Player>()?.PlayerData;
        var hide = pd is null || !pd.HasActiveCharacter;
        if ( hide != _isHidden )
        {
            _isHidden = hide;
            StateHasChanged();
        }

        if ( _renderedVersion != _inventory.Version )
        {
            _renderedVersion = _inventory.Version;
            StateHasChanged();
        }

        UpdateAnnouncement();

        HandleKeys();
    }

    /// <summary>
    /// Watch the selected slot and trigger the floating item-name banner
    /// every time the selection moves to a different slot. The banner is
    /// kept visible for <see cref="AnnounceHoldSeconds"/> seconds, then
    /// the CSS opacity transition fades it out.
    /// </summary>
    private void UpdateAnnouncement()
    {
        if ( _isHidden )
        {
            if ( _announceVisible )
            {
                _announceVisible = false;
                StateHasChanged();
            }
            return;
        }

        var current = _inventory.SelectedSlot;
        if ( current != _lastAnnouncedSlot )
        {
            _lastAnnouncedSlot = current;
            var slot = _inventory.Slot( current );
            var item = slot?.Item;
            // Empty or unknown slot: hide the announcement instead of
            // flashing a blank pill on screen.
            if ( slot is null || slot.IsEmpty || item is null )
            {
                _announceVisible = false;
                _announceText = "";
            }
            else
            {
                _announceText = item.Label ?? slot.ItemId ?? "";
                _announceVisible = true;
                _announceUntil = AnnounceHoldSeconds;
            }
            StateHasChanged();
            return;
        }

        // Hold window expired: drop the visible class so the CSS
        // transition fades the banner out. The element stays in the
        // tree so the fade-out actually plays.
        if ( _announceVisible && _announceUntil )
        {
            _announceVisible = false;
            StateHasChanged();
        }
    }

    private void HandleKeys()
    {
        if ( _inventory is null ) return;
        if ( _isHidden ) return;

        for ( int i = 0; i < MirageInventory.HotbarColumns; i++ )
        {
            var action = "Slot" + (i + 1);
            if ( Input.Pressed( action ) )
            {
                MirageInventoryService.RpcSelectSlot( i );
            }
        }

        // Mouse wheel cycles through hotbar slots. Skip while the inventory
        // panel is open so wheel scroll inside the panel does not
        // accidentally also rotate the hotbar selection.
        if ( !MirageInventoryPanelState.IsOpen )
        {
            var wheel = Input.MouseWheel.y;
            if ( wheel != 0f )
            {
                var step = wheel > 0f ? -1 : 1;
                var current = _inventory.SelectedSlot;
                if ( current < 0 ) current = 0;
                var next = (current + step + MirageInventory.HotbarColumns) % MirageInventory.HotbarColumns;
                MirageInventoryService.RpcSelectSlot( next );
            }
        }

        if ( Input.Pressed( "Drop" ) )
        {
            var sel = _inventory.SelectedSlot;
            if ( sel >= 0 ) MirageInventoryService.RpcDropSlot( sel, 0 );
        }
    }

    private void OnCellClick( int index )
    {
        MirageInventoryService.RpcSelectSlot( index );
    }

    private static string GetItemBadge( MirageItem item, string fallbackId )
    {
        var label = item?.Label ?? fallbackId;
        if ( string.IsNullOrEmpty( label ) ) return "?";
        return label.Substring( 0, 1 ).ToUpperInvariant();
    }

    protected override int BuildHash() => System.HashCode.Combine( _inventory?.Version, _inventory?.SelectedSlot, _isHidden, _announceVisible, _announceText );
}
