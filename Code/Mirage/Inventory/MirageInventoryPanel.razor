@*
    @author Epyi
*@
@using Sandbox
@using Sandbox.UI
@using Sandbox.Mirage
@using Sandbox.Mirage.UI
@inherits PanelComponent
@namespace Sandbox.Mirage.UI

<root class="mirage-inventory-panel @(MirageInventoryPanelState.IsOpen ? "open" : "")">

    <div class="backdrop" @onclick="@Close" @onmouseup="@OnBackdropMouseUp"></div>

    <div class="frame" @onmouseup="@OnFrameMouseUp">

        <div class="frame-header">
            <MirageLabel Variant="@(MirageLabel.LabelVariant.Heading)" Text="Inventaire" />
            <MirageLabel Variant="@(MirageLabel.LabelVariant.Caption)" Color="@(MirageLabel.LabelColor.Muted)" Text="@TopHint" />
        </div>

        @{
            var weightG = _inventory?.CurrentWeightGrams ?? 0;
            var maxG = MirageInventory.MaxWeightGrams;
            var fraction = (float)weightG / maxG;
            if ( fraction < 0f ) fraction = 0f;
            if ( fraction > 1f ) fraction = 1f;
            var fillPercent = (int)( fraction * 100 );
            var weightClass = fraction < 0.6f ? "weight--ok" : fraction < 0.9f ? "weight--warn" : "weight--full";
        }
        <div class="weight @weightClass">
            <div class="weight-row">
                <MirageLabel Variant="@(MirageLabel.LabelVariant.Eyebrow)" Color="@(MirageLabel.LabelColor.Secondary)" Text="POIDS" />
                <Label class="weight-numbers" Text="@($"{(weightG / 1000f):F2} / {(maxG / 1000f):F0} kg")" />
            </div>
            <div class="weight-track">
                <div class="weight-fill" style="width: @(fillPercent)%;"></div>
            </div>
        </div>

        <div class="grid">
            @for ( int row = 0; row < MirageInventory.SlotCount / MirageInventory.HotbarColumns; row++ )
            {
                <div class="row @(row == 0 ? "row--hotbar" : "")">
                    @for ( int col = 0; col < MirageInventory.HotbarColumns; col++ )
                    {
                        var idx = row * MirageInventory.HotbarColumns + col;
                        var captured = idx;
                        var slot = _inventory?.Slot( idx );
                        var item = slot?.Item;
                        var selected = _inventory?.SelectedSlot == idx && row == 0;
                        var empty = slot is null || slot.IsEmpty;
                        var dragging = _dragSource == idx;
                        <div class="cell @(selected ? "cell--selected" : "") @(empty ? "cell--empty" : "") @(dragging ? "cell--dragging" : "")"
                             @onmousedown="@(() => OnSlotMouseDown( captured ))"
                             @onmouseup="@(() => OnSlotMouseUp( captured ))"
                             @onmouseover="@(() => OnSlotHover( captured ))">
                            <div class="cell-top">
                                <Label class="cell-key" Text="@(row == 0 ? (col + 1).ToString() : "")" />
                                @if ( !empty && slot.Count > 1 )
                                {
                                    <Label class="cell-count" Text="@slot.Count.ToString()" />
                                }
                            </div>
                            <div class="cell-letter">
                                @if ( !empty )
                                {
                                    <Label Text="@GetItemBadge( item, slot.ItemId )" />
                                }
                            </div>
                            <div class="cell-name">
                                @if ( !empty )
                                {
                                    <Label Text="@(item?.Label ?? slot.ItemId)" />
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="actions">
            @if ( !IsDragging && _hoverSlot >= 0 && !( _inventory?.Slot( _hoverSlot )?.IsEmpty ?? true ) )
            {
                @{ var hovered = _inventory.Slot( _hoverSlot ); var hoveredItem = hovered.Item; }
                <div class="hover-info">
                    <MirageLabel Variant="@(MirageLabel.LabelVariant.Subtitle)" Text="@(hoveredItem?.Label ?? hovered.ItemId)" />
                    @if ( !string.IsNullOrEmpty( hoveredItem?.Description ) )
                    {
                        <MirageLabel Variant="@(MirageLabel.LabelVariant.Caption)" Color="@(MirageLabel.LabelColor.Secondary)" Text="@hoveredItem.Description" />
                    }
                    <MirageLabel Variant="@(MirageLabel.LabelVariant.Caption)" Color="@(MirageLabel.LabelColor.Muted)" Text="@($"x{hovered.Count} · {hoveredItem?.Weight ?? 0}g pièce")" />
                </div>
            }
            <MirageLabel Variant="@(MirageLabel.LabelVariant.Caption)" Color="@(MirageLabel.LabelColor.Muted)" Text="Glisse un item sur un autre slot pour déplacer ou empiler. Glisse en dehors de la fenêtre pour le lâcher au sol. Tab pour fermer." />
        </div>

    </div>

    @if ( IsDragging )
    {
        <div class="drag-visual" @ref="_dragVisual">
            <Label class="drag-letter" Text="@_dragBadge" />
            @if ( _dragCount > 1 )
            {
                <Label class="drag-count" Text="@_dragCount.ToString()" />
            }
        </div>
    }

</root>

@code
{
    private MirageInventory _inventory;
    private int _renderedVersion = -1;
    private int _hoverSlot = -1;

    // Active drag source slot index, -1 when no drag in progress.
    private int _dragSource = -1;
    private string _dragBadge;
    private int _dragCount;
    private Panel _dragVisual;
    private bool IsDragging => _dragSource >= 0;

    private string TopHint => IsDragging
        ? "Lâche sur un slot pour déplacer, en dehors pour jeter au sol."
        : "Tab pour fermer.";

    protected override void OnStart()
    {
        base.OnStart();
        MirageInventoryPanelState.Reset();
    }

    protected override void OnUpdate()
    {
        _inventory ??= MirageInventory.ForLocalPlayer();

        if ( _inventory is not null && Input.Pressed( "Inventory" ) )
        {
            MirageInventoryPanelState.Toggle();
        }

        var open = MirageInventoryPanelState.IsOpen;
        SetClass( "open", open );
        MirageModalLock.SetActive( open );

        if ( !open )
        {
            CancelDrag();
            return;
        }

        if ( _inventory is not null && _renderedVersion != _inventory.Version )
        {
            _renderedVersion = _inventory.Version;
            StateHasChanged();
        }

        if ( IsDragging )
        {
            UpdateDragVisual();
        }
    }

    private void Close()
    {
        if ( IsDragging ) return;
        MirageInventoryPanelState.SetOpen( false );
        StateHasChanged();
    }

    // -------- Drag and drop interactions --------

    // No event-arg overloads on these handlers: s&box's Razor binds
    // @onmouseup to an Action that gets the source Panel, not a
    // MousePanelEvent, so typing the parameter as MousePanelEvent triggers
    // an InvalidCastException at every render. The behaviour stays correct
    // because the slot handler clears _dragSource before the frame handler
    // bubbles, so the frame's "cancel drag" branch becomes a no-op.

    private void OnSlotMouseDown( int idx )
    {
        if ( _inventory is null ) return;
        var slot = _inventory.Slot( idx );
        if ( slot is null || slot.IsEmpty ) return;
        _dragSource = idx;
        _dragBadge = GetItemBadge( slot.Item, slot.ItemId );
        _dragCount = slot.Count;
        StateHasChanged();
    }

    private void OnSlotMouseUp( int idx )
    {
        if ( !IsDragging ) return;

        if ( _dragSource != idx )
        {
            MirageInventoryService.RpcMoveSlot( _dragSource, idx );
        }
        CancelDrag();
    }

    private void OnFrameMouseUp()
    {
        // Mouseup landed on the frame chrome but not on a slot: cancel the
        // drag without dropping or moving anything. Slot handlers run first
        // and clear _dragSource, so this is a no-op when the mouseup
        // actually landed on a slot inside the frame.
        if ( !IsDragging ) return;
        CancelDrag();
    }

    private void OnBackdropMouseUp()
    {
        // Mouseup outside the frame entirely (the backdrop fills the rest
        // of the screen): drop the dragged stack into the world. The
        // backdrop is a sibling of the frame, not an ancestor, so frame /
        // slot mouseups do not bubble here.
        if ( !IsDragging ) return;
        MirageInventoryService.RpcDropSlot( _dragSource, 0 );
        CancelDrag();
    }

    private void CancelDrag()
    {
        if ( _dragSource < 0 ) return;
        _dragSource = -1;
        _dragBadge = null;
        _dragCount = 0;
        StateHasChanged();
    }

    private void UpdateDragVisual()
    {
        if ( _dragVisual is null ) return;
        var scale = Panel.ScaleFromScreen;
        var pos = Mouse.Position * scale;
        _dragVisual.Style.Left = Length.Pixels( pos.x - 24 );
        _dragVisual.Style.Top = Length.Pixels( pos.y - 24 );
    }

    private void OnSlotHover( int idx )
    {
        _hoverSlot = idx;
        StateHasChanged();
    }

    private static string GetItemBadge( MirageItem item, string fallbackId )
    {
        var label = item?.Label ?? fallbackId;
        if ( string.IsNullOrEmpty( label ) ) return "?";
        return label.Substring( 0, 1 ).ToUpperInvariant();
    }

    protected override int BuildHash() => System.HashCode.Combine(
        MirageInventoryPanelState.IsOpen,
        _inventory?.Version,
        _inventory?.SelectedSlot,
        _hoverSlot,
        _dragSource
    );
}
