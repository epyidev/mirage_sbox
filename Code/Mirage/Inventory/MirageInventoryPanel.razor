@*
    @author Epyi
*@
@using Sandbox
@using Sandbox.UI
@using Sandbox.Mirage
@using Sandbox.Mirage.UI
@inherits PanelComponent
@namespace Sandbox.Mirage.UI

<root class="mirage-inventory-panel @(MirageInventoryPanelState.IsOpen ? "open" : "")"
      @onmouseup="@OnRootMouseUp">

    <div class="backdrop" @onclick="@Close"></div>

    <div class="frame" @ref="_frame">

        <div class="frame-header">
            <MirageLabel Variant="@(MirageLabel.LabelVariant.Heading)" Text="Inventaire" />
        </div>

        @{
            var weightG = _inventory?.CurrentWeightGrams ?? 0;
            var maxG = MirageInventory.MaxWeightGrams;
            var fraction = (float)weightG / maxG;
            if ( fraction < 0f ) fraction = 0f;
            if ( fraction > 1f ) fraction = 1f;
            var fillPercent = (int)( fraction * 100 );
            var weightClass = fraction < 0.6f ? "weight--ok" : fraction < 0.9f ? "weight--warn" : "weight--full";
        }
        <div class="weight @weightClass">
            <div class="weight-row">
                <MirageLabel Variant="@(MirageLabel.LabelVariant.Eyebrow)" Color="@(MirageLabel.LabelColor.Secondary)" Text="POIDS" />
                <Label class="weight-numbers" Text="@($"{(weightG / 1000f):F2} / {(maxG / 1000f):F0} kg")" />
            </div>
            <div class="weight-track">
                <div class="weight-fill" style="width: @(fillPercent)%;"></div>
            </div>
        </div>

        <div class="grid" @ref="_grid">
            @for ( int row = 0; row < MirageInventory.SlotCount / MirageInventory.HotbarColumns; row++ )
            {
                <div class="row @(row == 0 ? "row--hotbar" : "")">
                    @for ( int col = 0; col < MirageInventory.HotbarColumns; col++ )
                    {
                        var idx = row * MirageInventory.HotbarColumns + col;
                        var captured = idx;
                        var slot = _inventory?.Slot( idx );
                        var item = slot?.Item;
                        var selected = _inventory?.SelectedSlot == idx && row == 0;
                        var empty = slot is null || slot.IsEmpty;
                        var dragging = _dragSource == idx;
                        var dropTarget = IsDragging && _dropTarget == idx && _dropTarget != _dragSource;
                        <div class="cell @(selected ? "cell--selected" : "") @(empty ? "cell--empty" : "") @(dragging ? "cell--dragging" : "") @(dropTarget ? "cell--drop-target" : "")"
                             @onmousedown="@(() => OnSlotMouseDown( captured ))">
                            <div class="cell-top">
                                <Label class="cell-key" Text="@(row == 0 ? (col + 1).ToString() : "")" />
                            </div>
                            <div class="cell-letter">
                                @if ( !empty )
                                {
                                    if ( !string.IsNullOrEmpty( item?.Image ) )
                                    {
                                        <div class="cell-icon-stack">
                                            <div class="cell-icon" style="background-image: url(@item.Image);"></div>
                                        </div>
                                    }
                                    else
                                    {
                                        <Label Text="@GetItemBadge( item, slot.ItemId )" />
                                    }
                                }
                            </div>
                            @if ( !empty && slot.Count > 1 )
                            {
                                <Label class="cell-count" Text="@($"x{slot.Count}")" />
                            }
                        </div>
                    }
                </div>
            }
        </div>

    </div>

    @if ( IsDragging )
    {
        <div class="drag-visual" @ref="_dragVisual" style="left: @(_dragX)px; top: @(_dragY)px;">
            @if ( !string.IsNullOrEmpty( _dragImage ) )
            {
                <div class="drag-icon-stack">
                    <div class="drag-icon" style="background-image: url(@_dragImage);"></div>
                </div>
            }
            else
            {
                <Label class="drag-letter" Text="@_dragBadge" />
            }
            @if ( _dragCount > 1 )
            {
                <Label class="drag-count" Text="@($"x{_dragCount}")" />
            }
        </div>
    }

    @if ( !IsDragging && _hasTooltipItem )
    {
        @{ var tipSlot = _inventory?.Slot( _tooltipSlot ); var tipItem = tipSlot?.Item; }
        <div class="slot-tooltip" @ref="_tooltip" style="left: @(_tooltipX)px; top: @(_tooltipY)px;">
            <Label class="tooltip-name" Text="@(tipItem?.Label ?? tipSlot?.ItemId)" />
            @if ( !string.IsNullOrEmpty( tipItem?.Description ) )
            {
                <Label class="tooltip-desc" Text="@tipItem.Description" />
            }
            <Label class="tooltip-meta" Text="@($"x{tipSlot?.Count} · {tipItem?.Weight ?? 0}g pièce")" />
        </div>
    }

</root>

@code
{
    private MirageInventory _inventory;
    private int _renderedVersion = -1;

    // Refs into the rendered tree.
    private Panel _frame;
    private Panel _grid;
    private Panel _dragVisual;
    private Panel _tooltip;

    // Drag state
    private int _dragSource = -1;
    private string _dragBadge;
    private string _dragImage;
    private int _dragCount;
    private float _dragX, _dragY;
    private bool IsDragging => _dragSource >= 0;

    // Hit-test cache
    private int _dropTarget = -1;
    private int _tooltipSlot = -1;
    private float _tooltipX, _tooltipY;
    private bool _hasTooltipItem;

    private const float DragVisualSize = 80f;

    protected override void OnStart()
    {
        base.OnStart();
        MirageInventoryPanelState.Reset();
    }

    protected override void OnUpdate()
    {
        _inventory ??= MirageInventory.ForLocalPlayer();

        if ( _inventory is not null && Input.Pressed( "Inventory" ) )
        {
            MirageInventoryPanelState.Toggle();
        }

        var open = MirageInventoryPanelState.IsOpen;
        SetClass( "open", open );
        MirageModalLock.SetActive( open );

        if ( !open )
        {
            CancelDrag();
            if ( _hasTooltipItem ) { _tooltipSlot = -1; _hasTooltipItem = false; StateHasChanged(); }
            return;
        }

        if ( _inventory is not null && _renderedVersion != _inventory.Version )
        {
            _renderedVersion = _inventory.Version;
            StateHasChanged();
        }

        var mouse = Mouse.Position;
        var hover = HitTestSlot( mouse );
        var scale = Panel.ScaleFromScreen;

        if ( IsDragging )
        {
            if ( hover != _dropTarget ) { _dropTarget = hover; StateHasChanged(); }
            if ( _hasTooltipItem ) { _tooltipSlot = -1; _hasTooltipItem = false; StateHasChanged(); }

            _dragX = mouse.x * scale - DragVisualSize / 2f;
            _dragY = mouse.y * scale - DragVisualSize / 2f;
            if ( _dragVisual is not null )
            {
                _dragVisual.Style.Left = Length.Pixels( _dragX );
                _dragVisual.Style.Top = Length.Pixels( _dragY );
            }
        }
        else
        {
            if ( _dropTarget != -1 ) { _dropTarget = -1; StateHasChanged(); }

            var nextHasItem = false;
            if ( hover >= 0 )
            {
                var s = _inventory?.Slot( hover );
                nextHasItem = s is not null && !s.IsEmpty;
            }
            if ( hover != _tooltipSlot || nextHasItem != _hasTooltipItem )
            {
                _tooltipSlot = hover;
                _hasTooltipItem = nextHasItem;
                StateHasChanged();
            }

            if ( _hasTooltipItem )
            {
                _tooltipX = mouse.x * scale + 18f;
                _tooltipY = mouse.y * scale + 18f;
                if ( _tooltip is not null )
                {
                    _tooltip.Style.Left = Length.Pixels( _tooltipX );
                    _tooltip.Style.Top = Length.Pixels( _tooltipY );
                }
            }
        }
    }

    private void Close()
    {
        if ( IsDragging ) return;
        MirageInventoryPanelState.SetOpen( false );
        StateHasChanged();
    }

    private void OnSlotMouseDown( int idx )
    {
        if ( _inventory is null ) return;
        var slot = _inventory.Slot( idx );
        if ( slot is null || slot.IsEmpty ) return;
        _dragSource = idx;
        _dragBadge = GetItemBadge( slot.Item, slot.ItemId );
        _dragImage = slot.Item?.Image;
        _dragCount = slot.Count;
        var scale = Panel.ScaleFromScreen;
        var mouse = Mouse.Position;
        _dragX = mouse.x * scale - DragVisualSize / 2f;
        _dragY = mouse.y * scale - DragVisualSize / 2f;
        _tooltipSlot = -1;
        _hasTooltipItem = false;
        StateHasChanged();
    }

    /// <summary>
    /// Single mouseup handler at the panel root: resolves the drop based on
    /// where the cursor is when the operator releases the mouse, instead of
    /// relying on which child element captured the up event.
    /// </summary>
    private void OnRootMouseUp()
    {
        if ( !IsDragging ) return;
        var mouse = Mouse.Position;
        var target = HitTestSlot( mouse );

        if ( target >= 0 )
        {
            // Cursor over a slot: only act if it is a different one than
            // the source. Same slot release just cancels.
            if ( target != _dragSource )
            {
                MirageInventoryService.RpcMoveSlot( _dragSource, target );
            }
        }
        else if ( !IsInsideFrame( mouse ) )
        {
            // Cursor is fully outside the inventory frame: drop the stack
            // into the world.
            MirageInventoryService.RpcDropSlot( _dragSource, 0 );
        }
        // Inside the frame but not on a slot (header, weight bar, gaps):
        // cancel without doing anything.

        CancelDrag();
    }

    private void CancelDrag()
    {
        if ( _dragSource < 0 && _dropTarget < 0 ) return;
        _dragSource = -1;
        _dragBadge = null;
        _dragImage = null;
        _dragCount = 0;
        _dropTarget = -1;
        StateHasChanged();
    }

    private bool IsInsideFrame( Vector2 mouse )
    {
        return _frame is not null && _frame.IsValid() && _frame.Box.Rect.IsInside( mouse );
    }

    private int HitTestSlot( Vector2 mouse )
    {
        if ( _grid is null || !_grid.IsValid() ) return -1;
        var idx = 0;
        var rowCount = MirageInventory.SlotCount / MirageInventory.HotbarColumns;
        for ( int r = 0; r < rowCount; r++ )
        {
            var rowPanel = _grid.GetChild( r );
            if ( rowPanel is null )
            {
                idx += MirageInventory.HotbarColumns;
                continue;
            }
            for ( int c = 0; c < MirageInventory.HotbarColumns; c++ )
            {
                var cellPanel = rowPanel.GetChild( c );
                if ( cellPanel is not null && cellPanel.IsValid() && cellPanel.Box.Rect.IsInside( mouse ) )
                    return idx;
                idx++;
            }
        }
        return -1;
    }

    private static string GetItemBadge( MirageItem item, string fallbackId )
    {
        var label = item?.Label ?? fallbackId;
        if ( string.IsNullOrEmpty( label ) ) return "?";
        return label.Substring( 0, 1 ).ToUpperInvariant();
    }

    protected override int BuildHash() => System.HashCode.Combine(
        MirageInventoryPanelState.IsOpen,
        _inventory?.Version,
        _inventory?.SelectedSlot,
        _tooltipSlot,
        _dropTarget,
        _dragSource,
        _hasTooltipItem
    );
}
