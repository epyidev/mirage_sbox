@*
    @author Epyi
*@
@using Sandbox
@using Sandbox.UI
@using Sandbox.Mirage
@using Sandbox.Mirage.UI
@inherits PanelComponent
@namespace Sandbox.Mirage.UI

<root class="mirage-inventory-panel @(MirageInventoryPanelState.IsOpen ? "open" : "")"
      @onmouseup="@OnRootMouseUp">

    <div class="backdrop" @onclick="@Close"></div>

    <div class="frame-column">

    <div class="frame" @ref="_frame">

        <div class="frame-header">
            <MirageLabel Variant="@(MirageLabel.LabelVariant.Heading)" Text="Inventaire" />
        </div>

        @{
            var weightG = _inventory?.CurrentWeightGrams ?? 0;
            var maxG = MirageInventory.MaxWeightGrams;
            var fraction = (float)weightG / maxG;
            if ( fraction < 0f ) fraction = 0f;
            if ( fraction > 1f ) fraction = 1f;
            var fillPercent = (int)( fraction * 100 );
            var weightClass = fraction < 0.6f ? "weight--ok" : fraction < 0.9f ? "weight--warn" : "weight--full";
        }
        <div class="weight @weightClass">
            <div class="weight-row">
                <MirageLabel Variant="@(MirageLabel.LabelVariant.Eyebrow)" Color="@(MirageLabel.LabelColor.Secondary)" Text="POIDS" />
                <Label class="weight-numbers" Text="@($"{(weightG / 1000f):F2} / {(maxG / 1000f):F0} kg")" />
            </div>
            <div class="weight-track">
                <div class="weight-fill" style="width: @(fillPercent)%;"></div>
            </div>
        </div>

        <div class="grid" @ref="_grid">
            @for ( int row = 0; row < MirageInventory.SlotCount / MirageInventory.HotbarColumns; row++ )
            {
                <div class="row @(row == 0 ? "row--hotbar" : "")">
                    @for ( int col = 0; col < MirageInventory.HotbarColumns; col++ )
                    {
                        var idx = row * MirageInventory.HotbarColumns + col;
                        var captured = idx;
                        var slot = _inventory?.Slot( idx );
                        var item = slot?.Item;
                        var selected = _inventory?.SelectedSlot == idx && row == 0;
                        var empty = slot is null || slot.IsEmpty;
                        var dragging = _dragSource == idx;
                        var dropTarget = IsDragging && _dropTarget == idx && _dropTarget != _dragSource;
                        <div class="cell @(selected ? "cell--selected" : "") @(empty ? "cell--empty" : "") @(dragging ? "cell--dragging" : "") @(dropTarget ? "cell--drop-target" : "")"
                             @onmousedown="@(() => OnSlotMouseDown( captured ))">
                            <div class="cell-top">
                                <Label class="cell-key" Text="@(row == 0 ? (col + 1).ToString() : "")" />
                            </div>
                            <div class="cell-letter">
                                @if ( !empty )
                                {
                                    if ( !string.IsNullOrEmpty( item?.Image ) )
                                    {
                                        <div class="cell-icon-stack">
                                            <div class="cell-icon" style="background-image: url(@item.Image);"></div>
                                        </div>
                                    }
                                    else
                                    {
                                        <Label Text="@GetItemBadge( item, slot.ItemId )" />
                                    }
                                }
                            </div>
                            @{
                                var displayCount = ResolveDisplayCount( idx, slot, empty );
                            }
                            @if ( displayCount > 1 )
                            {
                                <Label class="cell-count" Text="@($"x{displayCount}")" />
                            }
                        </div>
                    }
                </div>
            }
        </div>

    </div>

    <div class="frame-info-button" @onclick="@ToggleHelp">
        <Label Text="i" />
    </div>

    </div>

    @if ( _helpOpen )
    {
        <div class="help-overlay" @onclick="@CloseHelp">
            <div class="help-frame" @onclick="@OnHelpFrameClick">
                <div class="help-title">
                    <MirageLabel Variant="@(MirageLabel.LabelVariant.Heading)" Text="Inventaire — Raccourcis" />
                </div>
                <div class="help-list">
                    <div class="help-row"><Label class="help-key" Text="Glisser-déposer" /><Label class="help-desc" Text="Déplace un stack vers une autre case ou échange deux cases" /></div>
                    <div class="help-row"><Label class="help-key" Text="Clic droit + glisser" /><Label class="help-desc" Text="Coupe le stack en deux et déplace la moitié, à régler avec la molette" /></div>
                    <div class="help-row"><Label class="help-key" Text="Molette pendant un split" /><Label class="help-desc" Text="Ajuste de ±1 le nombre d'items détachés" /></div>
                    <div class="help-row"><Label class="help-key" Text="Survol + 1 à 5" /><Label class="help-desc" Text="Echange l'item survolé avec la case correspondante de la hotbar" /></div>
                    <div class="help-row"><Label class="help-key" Text="Glisser hors du cadre" /><Label class="help-desc" Text="Drop l'item au sol (la moitié pendant un split)" /></div>
                    <div class="help-row"><Label class="help-key" Text="Tab" /><Label class="help-desc" Text="Ouvre / ferme l'inventaire" /></div>
                    <div class="help-row"><Label class="help-key" Text="Molette hors panel" /><Label class="help-desc" Text="Cycle entre les slots de la hotbar" /></div>
                    <div class="help-row"><Label class="help-key" Text="G" /><Label class="help-desc" Text="Drop le slot actuellement équipé" /></div>
                </div>
                <div class="help-footer">
                    <MirageButton Text="Fermer" Variant="@(MirageButton.ButtonVariant.Secondary)" Size="@(MirageButton.ButtonSize.Small)" ClickAction="@CloseHelp" />
                </div>
            </div>
        </div>
    }

    @if ( IsDragging )
    {
        var dragDisplayCount = _splitMode ? _splitAmount : _dragCount;
        <div class="drag-visual @(_splitMode ? "drag-visual--split" : "")" @ref="_dragVisual" style="left: @(_dragX)px; top: @(_dragY)px;">
            @if ( !string.IsNullOrEmpty( _dragImage ) )
            {
                <div class="drag-icon-stack">
                    <div class="drag-icon" style="background-image: url(@_dragImage);"></div>
                </div>
            }
            else
            {
                <Label class="drag-letter" Text="@_dragBadge" />
            }
            @if ( dragDisplayCount > 1 || _splitMode )
            {
                <Label class="drag-count" Text="@($"x{dragDisplayCount}")" />
            }
        </div>
    }

    @if ( !IsDragging && _hasTooltipItem )
    {
        @{ var tipSlot = _inventory?.Slot( _tooltipSlot ); var tipItem = tipSlot?.Item; }
        <div class="slot-tooltip" @ref="_tooltip" style="left: @(_tooltipX)px; top: @(_tooltipY)px;">
            <Label class="tooltip-name" Text="@(tipItem?.Label ?? tipSlot?.ItemId)" />
            @if ( !string.IsNullOrEmpty( tipItem?.Description ) )
            {
                <Label class="tooltip-desc" Text="@tipItem.Description" />
            }
            <Label class="tooltip-meta" Text="@($"x{tipSlot?.Count} · {tipItem?.Weight ?? 0}g pièce")" />
        </div>
    }

</root>

@code
{
    private MirageInventory _inventory;
    private int _renderedVersion = -1;

    // Refs into the rendered tree.
    private Panel _frame;
    private Panel _grid;
    private Panel _dragVisual;
    private Panel _tooltip;

    // Drag state
    private int _dragSource = -1;
    private string _dragBadge;
    private string _dragImage;
    private int _dragCount;
    private float _dragX, _dragY;
    private bool IsDragging => _dragSource >= 0;

    // Right-click split mode. The source stack stays put visually with
    // (Total - Amount) on it, the drag preview shows Amount, and the
    // operator can re-balance live with the mouse wheel before
    // releasing.
    private bool _splitMode;
    private int _splitTotal;
    private int _splitAmount;

    // Hit-test cache
    private int _dropTarget = -1;
    private int _tooltipSlot = -1;
    private float _tooltipX, _tooltipY;
    private bool _hasTooltipItem;

    // Number-key hover swap edge detection. Without this we would fire a
    // swap on every frame the key is held down.
    private bool[] _slotKeyArmed = new bool[5];

    private const float DragVisualSize = 80f;

    // Help overlay (the small "i" button below the frame)
    private bool _helpOpen;

    protected override void OnStart()
    {
        base.OnStart();
        MirageInventoryPanelState.Reset();
    }

    protected override void OnUpdate()
    {
        // Re-resolve when invalid: after a death/respawn the old
        // MirageInventory is destroyed alongside the previous player
        // GameObject. The cached field stays non-null but unusable, so
        // ??= alone would never refresh.
        if ( !_inventory.IsValid() )
        {
            _inventory = MirageInventory.ForLocalPlayer();
            _renderedVersion = -1;
        }

        if ( _inventory.IsValid() && Input.Pressed( "Inventory" ) )
        {
            MirageInventoryPanelState.Toggle();
        }

        var openBefore = MirageInventoryPanelState.IsOpen;

        // Sample the Slot1..Slot5 keys BEFORE MirageModalLock clears
        // them. Without this snapshot the panel can never see them:
        // SetActive nukes the action state for the rest of the frame.
        bool[] slotPressed = SampleSlotKeys( openBefore );

        var open = MirageInventoryPanelState.IsOpen;
        SetClass( "open", open );
        MirageModalLock.SetActive( open );

        if ( !open )
        {
            CancelDrag();
            if ( _hasTooltipItem ) { _tooltipSlot = -1; _hasTooltipItem = false; StateHasChanged(); }
            ResetSlotKeyArmed();
            return;
        }

        if ( _inventory is not null && _renderedVersion != _inventory.Version )
        {
            _renderedVersion = _inventory.Version;
            StateHasChanged();
        }

        var mouse = Mouse.Position;
        var hover = HitTestSlot( mouse );
        var scale = Panel.ScaleFromScreen;

        // Number-key hover swap: pressing 1..5 while hovering a slot
        // (and not dragging) swaps that slot with the matching hotbar
        // slot. Edge-detected so a held key only fires once.
        if ( !IsDragging && hover >= 0 )
        {
            for ( int i = 0; i < 5; i++ )
            {
                if ( slotPressed[i] && !_slotKeyArmed[i] )
                {
                    _slotKeyArmed[i] = true;
                    if ( hover != i )
                    {
                        MirageInventoryService.RpcMoveSlot( hover, i );
                    }
                }
                else if ( !slotPressed[i] )
                {
                    _slotKeyArmed[i] = false;
                }
            }
        }
        else
        {
            ResetSlotKeyArmed();
        }

        // Mouse-wheel adjusts the split point during a split drag.
        if ( IsDragging && _splitMode )
        {
            var wheel = Input.MouseWheel.y;
            if ( wheel != 0f )
            {
                var step = wheel > 0f ? 1 : -1;
                SetSplitAmount( _splitAmount + step );
            }
        }

        if ( IsDragging )
        {
            if ( hover != _dropTarget ) { _dropTarget = hover; StateHasChanged(); }
            if ( _hasTooltipItem ) { _tooltipSlot = -1; _hasTooltipItem = false; StateHasChanged(); }

            _dragX = mouse.x * scale - DragVisualSize / 2f;
            _dragY = mouse.y * scale - DragVisualSize / 2f;
            if ( _dragVisual is not null )
            {
                _dragVisual.Style.Left = Length.Pixels( _dragX );
                _dragVisual.Style.Top = Length.Pixels( _dragY );
            }
        }
        else
        {
            if ( _dropTarget != -1 ) { _dropTarget = -1; StateHasChanged(); }

            var nextHasItem = false;
            if ( hover >= 0 )
            {
                var s = _inventory?.Slot( hover );
                nextHasItem = s is not null && !s.IsEmpty;
            }
            if ( hover != _tooltipSlot || nextHasItem != _hasTooltipItem )
            {
                _tooltipSlot = hover;
                _hasTooltipItem = nextHasItem;
                StateHasChanged();
            }

            if ( _hasTooltipItem )
            {
                _tooltipX = mouse.x * scale + 18f;
                _tooltipY = mouse.y * scale + 18f;
                if ( _tooltip is not null )
                {
                    _tooltip.Style.Left = Length.Pixels( _tooltipX );
                    _tooltip.Style.Top = Length.Pixels( _tooltipY );
                }
            }
        }
    }

    private void Close()
    {
        if ( IsDragging ) return;
        MirageInventoryPanelState.SetOpen( false );
        _helpOpen = false;
        StateHasChanged();
    }

    private void ToggleHelp()
    {
        _helpOpen = !_helpOpen;
        StateHasChanged();
    }

    private void CloseHelp()
    {
        if ( !_helpOpen ) return;
        _helpOpen = false;
        StateHasChanged();
    }

    /// <summary>
    /// The help backdrop closes the overlay when clicked. Clicks on the
    /// frame itself need to be swallowed so they do not bubble back to
    /// the backdrop and dismiss the modal mid-read.
    /// </summary>
    private void OnHelpFrameClick()
    {
        // No-op on purpose: stops the click from reaching the
        // backdrop's @onclick="Close".
    }

    private void OnSlotMouseDown( int idx )
    {
        if ( _inventory is null ) return;
        if ( IsDragging ) return;

        var slot = _inventory.Slot( idx );
        if ( slot is null || slot.IsEmpty ) return;

        // The mouse-down binding fires on any button. We check attack2
        // (right click) at this exact moment to decide whether this
        // is a split drag or a regular full-stack move. Mouse events
        // fire before MirageModalLock's per-frame Input.Clear runs,
        // so the action is still readable here. Stacks of 1 fall back
        // to a normal drag because there is nothing to split off.
        bool wantsSplit = Input.Down( "attack2" ) && slot.Count > 1;
        BeginDragFrom( idx, slot, splitMode: wantsSplit );
    }

    private void BeginDragFrom( int idx, MirageInventorySlot slot, bool splitMode )
    {
        _dragSource = idx;
        _dragBadge = GetItemBadge( slot.Item, slot.ItemId );
        _dragImage = slot.Item?.Image;
        _dragCount = slot.Count;
        _splitMode = splitMode;
        if ( splitMode )
        {
            _splitTotal = slot.Count;
            _splitAmount = Math.Max( 1, slot.Count / 2 );
        }
        else
        {
            _splitTotal = 0;
            _splitAmount = 0;
        }
        var scale = Panel.ScaleFromScreen;
        var mouse = Mouse.Position;
        _dragX = mouse.x * scale - DragVisualSize / 2f;
        _dragY = mouse.y * scale - DragVisualSize / 2f;
        _tooltipSlot = -1;
        _hasTooltipItem = false;
        StateHasChanged();
    }

    private void SetSplitAmount( int amount )
    {
        if ( !_splitMode ) return;
        var clamped = Math.Clamp( amount, 1, Math.Max( 1, _splitTotal - 1 ) );
        if ( clamped == _splitAmount ) return;
        _splitAmount = clamped;
        StateHasChanged();
    }

    /// <summary>
    /// Single mouseup handler at the panel root: resolves the drop based on
    /// where the cursor is when the operator releases the mouse, instead of
    /// relying on which child element captured the up event.
    /// </summary>
    private void OnRootMouseUp()
    {
        if ( !IsDragging ) return;
        var mouse = Mouse.Position;
        var target = HitTestSlot( mouse );

        if ( target >= 0 )
        {
            if ( target != _dragSource )
            {
                if ( _splitMode )
                {
                    MirageInventoryService.RpcSplitMove( _dragSource, target, _splitAmount );
                }
                else
                {
                    MirageInventoryService.RpcMoveSlot( _dragSource, target );
                }
            }
        }
        else if ( !IsInsideFrame( mouse ) )
        {
            // Cursor is fully outside the inventory frame: drop into the
            // world. In split mode only the carried half goes; otherwise
            // the whole stack goes.
            var dropCount = _splitMode ? _splitAmount : 0;
            MirageInventoryService.RpcDropSlot( _dragSource, dropCount );
        }
        // Inside the frame but not on a slot: cancel.

        CancelDrag();
    }

    private void CancelDrag()
    {
        if ( _dragSource < 0 && _dropTarget < 0 && !_splitMode ) return;
        _dragSource = -1;
        _dragBadge = null;
        _dragImage = null;
        _dragCount = 0;
        _dropTarget = -1;
        _splitMode = false;
        _splitTotal = 0;
        _splitAmount = 0;
        StateHasChanged();
    }

    private bool[] SampleSlotKeys( bool open )
    {
        var arr = new bool[5];
        if ( !open ) return arr;
        for ( int i = 0; i < 5; i++ )
        {
            arr[i] = Input.Down( "Slot" + (i + 1) );
        }
        return arr;
    }

    private void ResetSlotKeyArmed()
    {
        for ( int i = 0; i < _slotKeyArmed.Length; i++ ) _slotKeyArmed[i] = false;
    }

    /// <summary>
    /// Count to render on cell <paramref name="idx"/>. During a split
    /// drag the source cell shows the leftover (Total - Amount) so the
    /// operator sees the split happen live before they commit.
    /// </summary>
    private int ResolveDisplayCount( int idx, MirageInventorySlot slot, bool empty )
    {
        if ( empty || slot is null ) return 0;
        if ( _splitMode && _dragSource == idx )
        {
            return Math.Max( 0, slot.Count - _splitAmount );
        }
        return slot.Count;
    }

    private bool IsInsideFrame( Vector2 mouse )
    {
        return _frame is not null && _frame.IsValid() && _frame.Box.Rect.IsInside( mouse );
    }

    private int HitTestSlot( Vector2 mouse )
    {
        if ( _grid is null || !_grid.IsValid() ) return -1;
        var idx = 0;
        var rowCount = MirageInventory.SlotCount / MirageInventory.HotbarColumns;
        for ( int r = 0; r < rowCount; r++ )
        {
            var rowPanel = _grid.GetChild( r );
            if ( rowPanel is null )
            {
                idx += MirageInventory.HotbarColumns;
                continue;
            }
            for ( int c = 0; c < MirageInventory.HotbarColumns; c++ )
            {
                var cellPanel = rowPanel.GetChild( c );
                if ( cellPanel is not null && cellPanel.IsValid() && cellPanel.Box.Rect.IsInside( mouse ) )
                    return idx;
                idx++;
            }
        }
        return -1;
    }

    private static string GetItemBadge( MirageItem item, string fallbackId )
    {
        var label = item?.Label ?? fallbackId;
        if ( string.IsNullOrEmpty( label ) ) return "?";
        return label.Substring( 0, 1 ).ToUpperInvariant();
    }

    protected override int BuildHash() => System.HashCode.Combine(
        MirageInventoryPanelState.IsOpen,
        _inventory?.Version,
        _inventory?.SelectedSlot,
        _tooltipSlot,
        _dropTarget,
        _dragSource,
        _hasTooltipItem,
        System.HashCode.Combine( _splitMode, _splitAmount, _helpOpen )
    );
}
