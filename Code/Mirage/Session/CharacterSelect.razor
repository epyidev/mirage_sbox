@*
    @author Epyi
*@
@using Sandbox
@using Sandbox.Mirage
@using Sandbox.Mirage.UI
@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox.Mirage.UI

<root class="mirage-character-select">

    <div class="backdrop"></div>

    <div class="strip">

        <div class="strip-title">
            <MirageLabel Variant="@(MirageLabel.LabelVariant.Eyebrow)"
                         Color="@(MirageLabel.LabelColor.Secondary)"
                         Text="Sélection du personnage" />
        </div>

        @if ( !MirageClientCache.HasSnapshot )
        {
            <MirageLabel Variant="@(MirageLabel.LabelVariant.Body)"
                         Color="@(MirageLabel.LabelColor.Secondary)"
                         Align="@(MirageLabel.LabelAlign.Center)"
                         Text="Chargement des personnages..." />
        }
        else if ( MirageClientCache.Characters.Count == 0 )
        {
            <MirageLabel Variant="@(MirageLabel.LabelVariant.Body)"
                         Color="@(MirageLabel.LabelColor.Warning)"
                         Align="@(MirageLabel.LabelAlign.Center)"
                         Text="Aucun personnage. Clique sur la carte « + » pour en créer un." />
        }

        @if ( MirageClientCache.HasSnapshot )
        {
            <div class="cards">

                @foreach ( var character in MirageClientCache.Characters )
                {
                    var c = character;
                    <div class="card character" @onclick="@(() => OnSelect( c ))">
                        <MirageLabel Variant="@(MirageLabel.LabelVariant.Heading)" Text="@($"{c.FirstName} {c.LastName}")" />
                        <div class="meta">
                            <MirageLabel Variant="@(MirageLabel.LabelVariant.Caption)"
                                         Color="@(MirageLabel.LabelColor.Secondary)"
                                         Text="@(c.Gender == "f" ? "Femme" : "Homme")" />
                            <MirageLabel Variant="@(MirageLabel.LabelVariant.Caption)"
                                         Color="@(MirageLabel.LabelColor.Secondary)"
                                         Text="@($"{c.HeightCm} cm")" />
                            <MirageLabel Variant="@(MirageLabel.LabelVariant.Caption)"
                                         Color="@(MirageLabel.LabelColor.Muted)"
                                         Text="@($"Né(e) le {c.BirthDate}")" />
                        </div>
                        <div class="card-cta">
                            <MirageLabel Variant="@(MirageLabel.LabelVariant.Eyebrow)"
                                         Color="@(MirageLabel.LabelColor.Accent)"
                                         Text="Jouer →" />
                        </div>
                    </div>
                }

                @if ( CanCreateMore() )
                {
                    <div class="card add-new" @onclick="@OpenCreateForm">
                        <Label class="plus" Text="+" />
                        <MirageLabel Variant="@(MirageLabel.LabelVariant.Eyebrow)"
                                     Color="@(MirageLabel.LabelColor.Secondary)"
                                     Text="Nouveau personnage" />
                    </div>
                }

            </div>
        }

        @if ( !string.IsNullOrEmpty( MirageClientCache.LastError ) )
        {
            <MirageLabel Variant="@(MirageLabel.LabelVariant.Caption)"
                         Color="@(MirageLabel.LabelColor.Danger)"
                         Align="@(MirageLabel.LabelAlign.Center)"
                         Text="@MirageClientCache.LastError" />
        }

    </div>

    @if ( _formOpen )
    {
        <div class="form-overlay">
            <div class="form-frame">

                <MirageHeader Title="Nouveau personnage" Closable="@(true)" OnClose="@CloseCreateForm" />

                <div class="form-body">
                    <MirageStack Gap="@(MirageStack.StackGap.Md)">
                        <Body>
                            <MirageTextInput @ref="_firstName" LabelText="Prénom" Placeholder="Jean" MaxLength="@(32)" />
                            <MirageTextInput @ref="_lastName" LabelText="Nom" Placeholder="Dupont" MaxLength="@(32)" />
                            <MirageTextInput @ref="_birthDate" LabelText="Date de naissance" Placeholder="AAAA-MM-JJ" MaxLength="@(10)" />
                            <MirageTextInput @ref="_heightCm" LabelText="Taille (cm)" Placeholder="180" MaxLength="@(3)" Numeric="@(true)" />

                            <div class="form-field">
                                <MirageLabel Variant="@(MirageLabel.LabelVariant.Eyebrow)" Text="Genre" />
                                <MirageSegmented Items="@_genderItems" Value="@_gender" OnChange="@OnGenderChange" />
                            </div>

                            @if ( !string.IsNullOrEmpty( _formError ) )
                            {
                                <MirageLabel Variant="@(MirageLabel.LabelVariant.Caption)"
                                             Color="@(MirageLabel.LabelColor.Danger)"
                                             Text="@_formError" />
                            }
                        </Body>
                    </MirageStack>
                </div>

                <div class="form-actions">
                    <MirageButton Text="Annuler"
                                  Variant="@(MirageButton.ButtonVariant.Ghost)"
                                  Size="@(MirageButton.ButtonSize.Medium)"
                                  ClickAction="@CloseCreateForm" />
                    <MirageButton Text="Créer le personnage"
                                  Variant="@(MirageButton.ButtonVariant.Primary)"
                                  Size="@(MirageButton.ButtonSize.Medium)"
                                  ClickAction="@SubmitCreateForm" />
                </div>

            </div>
        </div>
    }

</root>

@code
{
    private const int MaxCharacterSlots = 8;

    private bool _formOpen;
    private string _formError;
    private string _gender = "m";

    private MirageTextInput _firstName;
    private MirageTextInput _lastName;
    private MirageTextInput _birthDate;
    private MirageTextInput _heightCm;

    private bool _hasRequestedList;
    private int _renderedVersion = -1;

    private readonly List<MirageSegmented.SegmentedItem> _genderItems = new()
    {
        new MirageSegmented.SegmentedItem { Value = "m", Label = "Homme" },
        new MirageSegmented.SegmentedItem { Value = "f", Label = "Femme" }
    };

    protected override void OnUpdate()
    {
        var visible = ShouldBeVisible();
        SetClass( "open", visible );

        if ( !visible )
        {
            if ( _formOpen ) _formOpen = false;
            _hasRequestedList = false;
            return;
        }

        if ( !_hasRequestedList )
        {
            _hasRequestedList = true;
            MirageClientCache.Reset();
            MirageSession.RpcRequestCharacters();
        }

        if ( _renderedVersion != MirageClientCache.Version )
        {
            _renderedVersion = MirageClientCache.Version;
            StateHasChanged();
        }
    }

    private bool ShouldBeVisible()
    {
        if ( Connection.Local is null ) return false;
        var pd = PlayerData.For( Connection.Local );
        if ( pd is null ) return false;
        return !pd.HasActiveCharacter;
    }

    private bool CanCreateMore()
    {
        return MirageClientCache.Characters.Count < MaxCharacterSlots;
    }

    private void OnSelect( MirageCharacterSummary character )
    {
        if ( character is null || string.IsNullOrEmpty( character.Id ) ) return;
        MirageSession.RpcSelectCharacter( character.Id );
    }

    private void OpenCreateForm()
    {
        _formOpen = true;
        _formError = null;
        _gender = "m";
        StateHasChanged();
    }

    private void OnGenderChange( string gender )
    {
        _gender = gender;
        StateHasChanged();
    }

    private void CloseCreateForm()
    {
        _formOpen = false;
        _formError = null;
        StateHasChanged();
    }

    private void SubmitCreateForm()
    {
        var firstName = (_firstName?.Text ?? "").Trim();
        var lastName = (_lastName?.Text ?? "").Trim();
        var birthDate = (_birthDate?.Text ?? "").Trim();
        var heightText = (_heightCm?.Text ?? "").Trim();

        if ( firstName.Length == 0 || firstName.Length > 32 ) { _formError = "Le prénom doit faire entre 1 et 32 caractères."; return; }
        if ( lastName.Length == 0 || lastName.Length > 32 ) { _formError = "Le nom doit faire entre 1 et 32 caractères."; return; }
        if ( !System.Text.RegularExpressions.Regex.IsMatch( birthDate, @"^\d{4}-\d{2}-\d{2}$" ) ) { _formError = "La date de naissance doit être au format AAAA-MM-JJ."; return; }
        if ( !int.TryParse( heightText, out var heightCm ) || heightCm < 50 || heightCm > 272 ) { _formError = "La taille doit être un nombre entre 50 et 272."; return; }
        if ( _gender != "m" && _gender != "f" ) { _formError = "Choisis un genre."; return; }

        var slot = NextFreeSlot();

        MirageSession.RpcCreateCharacter( slot, firstName, lastName, birthDate, heightCm, _gender );

        _formOpen = false;
        _formError = null;
        StateHasChanged();
    }

    private int NextFreeSlot()
    {
        var used = new HashSet<int>();
        foreach ( var c in MirageClientCache.Characters )
            used.Add( c.Slot );
        for ( int i = 0; i < MaxCharacterSlots; i++ )
        {
            if ( !used.Contains( i ) ) return i;
        }
        return 0;
    }

    protected override int BuildHash() => System.HashCode.Combine( ShouldBeVisible(), _formOpen, MirageClientCache.Version, _gender, _formError, RealTime.Now.CeilToInt() );
}
