@*
    @author Epyi
*@
@using Sandbox
@using Sandbox.UI
@inherits Panel
@namespace Sandbox.Mirage.UI

<root class="mirage-segmented mirage-segmented--@(Size.ToString().ToLower()) @(Disabled ? "mirage-segmented--disabled" : "")">

    @if ( Items is not null )
    {
        @foreach ( var item in Items )
        {
            var captured = item;
            var isSelected = captured.Value == Value;
            <div class="seg @(isSelected ? "seg--selected" : "")" @onclick="@(() => OnSelect( captured ))">
                @if ( !string.IsNullOrEmpty( captured.Icon ) )
                {
                    <i class="icon">@captured.Icon</i>
                }
                <Label class="text" Text="@captured.Label" />
            </div>
        }
    }

</root>

@code
{
    public sealed class SegmentedItem
    {
        public string Value { get; init; }
        public string Label { get; init; }
        public string Icon { get; init; }
    }

    public enum SegmentedSize { Small, Medium, Large }

    [Parameter] public List<SegmentedItem> Items { get; set; } = new();
    [Parameter] public string Value { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public SegmentedSize Size { get; set; } = SegmentedSize.Medium;
    [Parameter] public Action<string> OnChange { get; set; }

    private void OnSelect( SegmentedItem item )
    {
        if ( Disabled || item is null ) return;
        if ( Value == item.Value ) return;
        Value = item.Value;
        OnChange?.Invoke( Value );
        StateHasChanged();
    }
}
