@*
    @author Epyi
*@
@using Sandbox
@using Sandbox.UI
@inherits Panel
@namespace Sandbox.Mirage.UI

<root class="mirage-toggle @(Active ? "mirage-toggle--active" : "") @(Disabled ? "mirage-toggle--disabled" : "")"
      @onclick="@OnRootClick">

    @if ( !string.IsNullOrEmpty( Icon ) )
    {
        <i class="icon">@Icon</i>
    }
    @if ( !string.IsNullOrEmpty( Text ) )
    {
        <Label class="text" Text="@Text" />
    }

</root>

@code
{
    [Parameter] public string Text { get; set; }
    [Parameter] public string Icon { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Action<bool> OnChange { get; set; }

    private void OnRootClick()
    {
        if ( Disabled ) return;
        Active = !Active;
        OnChange?.Invoke( Active );
        StateHasChanged();
    }
}
