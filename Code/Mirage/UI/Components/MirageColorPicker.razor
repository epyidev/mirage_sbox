@*
    @author Epyi

    Compact button-style colour picker. Closed it shows a square swatch with
    the hex value next to it, the same height as a MirageButton. Clicking it
    opens a MirageColorPickerPopup floating above the rest of the UI.
*@
@using Sandbox
@using Sandbox.UI
@inherits Panel
@namespace Sandbox.Mirage.UI

<root class="mirage-color-picker @(_popup is not null ? "mirage-color-picker--open" : "") @(Disabled ? "mirage-color-picker--disabled" : "")">

    @if ( !string.IsNullOrEmpty( LabelText ) )
    {
        <MirageLabel Variant="@(MirageLabel.LabelVariant.Eyebrow)" Text="@LabelText" />
    }

    <div class="trigger" @ref="_trigger" @onclick="@OnTriggerClick">
        <div class="swatch" @ref="_swatch"></div>
        <Label class="hex" Text="@HexValue" />
        <i class="caret">@(_popup is not null ? "▲" : "▼")</i>
    </div>

</root>

@code
{
    [Parameter] public string LabelText { get; set; }
    [Parameter] public Color Value { get; set; } = Color.White;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Action<Color> OnChange { get; set; }

    private Panel _trigger;
    private Panel _swatch;
    private MirageColorPickerPopup _popup;

    private string HexValue
    {
        get
        {
            var c = Value;
            var r = (int)(MathX.Clamp( c.r, 0f, 1f ) * 255f);
            var g = (int)(MathX.Clamp( c.g, 0f, 1f ) * 255f);
            var b = (int)(MathX.Clamp( c.b, 0f, 1f ) * 255f);
            return $"#{r:X2}{g:X2}{b:X2}";
        }
    }

    public override void Tick()
    {
        base.Tick();
        if ( _swatch is not null && _swatch.IsValid() )
        {
            _swatch.Style.BackgroundColor = Value;
        }
    }

    private void OnTriggerClick()
    {
        if ( Disabled ) return;
        if ( _popup is not null )
        {
            ClosePopup();
        }
        else
        {
            OpenPopup();
        }
    }

    private void OpenPopup()
    {
        var root = FindRootPanel();
        if ( root is null || _trigger is null || !_trigger.IsValid() ) return;

        var triggerRect = _trigger.Box.Rect;

        // Popup is roughly 280 px tall in screen px (SV square + hue + footer + padding).
        var desiredScreenHeight = 320f;
        var spaceBelow = Screen.Height - triggerRect.Bottom;
        var spaceAbove = triggerRect.Top;
        // Prefer opening up unless there's clearly more room below.
        var openUp = spaceAbove >= desiredScreenHeight || spaceAbove > spaceBelow;

        _popup = root.AddChild<MirageColorPickerPopup>();
        _popup.InitialColor = Value;
        _popup.TriggerRect = triggerRect;
        _popup.OpenUp = openUp;
        _popup.OnColorChange = OnPopupColorChange;
        _popup.OnDismiss = ClosePopup;
        _popup.StateHasChanged();
        StateHasChanged();
    }

    private void ClosePopup()
    {
        if ( _popup is not null )
        {
            _popup.Delete();
            _popup = null;
            StateHasChanged();
        }
    }

    private void OnPopupColorChange( Color c )
    {
        Value = c;
        OnChange?.Invoke( c );
        StateHasChanged();
    }

    public override void OnDeleted()
    {
        base.OnDeleted();
        ClosePopup();
    }
}
