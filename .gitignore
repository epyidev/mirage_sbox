
# This file describes files and paths that should not be tracked by Git version control
# https://git-scm.com/docs/gitignore

# Auto-generated code editor files
.vs/*
.vscode/*
*.csproj
obj
bin
Properties/*
code/obj/*
code/Properties/*

# Auto-generated asset related files
.sbox/*
*.generated.*
*.*_c
!*.shader_c
*.los
*.vpk
*launchSettings.json
*.sln

*idea

# Exported / standalone games
Exports/
*.user
*.slnx

# Backend API (Node)
Api/node_modules/
Api/dist/
Api/.env
Api/.env.*
!Api/.env.example
Api/*.log
Api/coverage/
Api/*.tsbuildinfo
